{
  "name": "solution25/sezzle",
  "description": "sezzle/sezzle",
  "type": "shopware-platform-plugin",
  "version": "1.0.1",
  "license": "MIT",
  "authors": [
    {
      "name": "Solution25",
      "email": "edon@solution25.com",
      "role": "Developer"
    }
  ],
  "require": {
    "shopware/core": "6.6 || ~6.7.0",
    "shopware/storefront": "6.6 || ~6.7.0"
  },
  "extra": {
    "shopware-plugin-class": "Sezzle\\Sezzle",
    "plugin-icon": "src/Resources/config/plugin.png",
    "label": {
      "de-DE": "Sezzle Payment",
      "en-GB": "Sezzle Payment"
    },
    "description": {
      "de-DE": "Sezzle Buy Now Pay Later Integration für Shopware 6. Ermöglicht Kunden, in 4 Raten zu zahlen – ohne Zinsen. Einfache Integration und sichere Abwicklung für Ihren Online-Shop.",
      "en-GB": "Sezzle Buy Now Pay Later integration for Shopware 6. Enables customers to pay in 4 interest-free installments. Easy integration and secure processing for your online store."
    },
    "manufacturerLink": {
      "de-DE": "https://www.solution25.com",
      "en-GB": "https://www.solution25.com"
    },
    "supportLink": {
      "de-DE": "https://www.solution25.com/kontakt",
      "en-GB": "https://www.solution25.com/contact"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Sezzle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sezzle\\Tests\\": "tests/"
    }
  }
}
