{% sw_extends '@Storefront/storefront/component/payment/payment-method.html.twig' %}

{% block component_payment_method_field %}
    {{ parent() }}

    {% if payment.id is same as(context.paymentMethod.id) and payment.handlerIdentifier == 'Sezzle\\Gateways\\SezzlePaymentHandler' %}
        {% set sezzleData = page.extensions.sezzle ?? null %}

        {% if sezzleData %}
            <div id="sezzle-plugin-wrapper"
                 data-sezzle-plugin
                 data-payment-method-id="{{ payment.id }}"
                 data-sezzle-merchant-id="{{ sezzleData.merchantId ?? '' }}"
                 data-sezzle-mode="{{ sezzleData.mode ?? 'sandbox' }}"
                 data-sezzle-popup-form-style="{{ sezzleData.popupFormStyle ?? 'redirect' }}"
                 data-sezzle-public-key="{{ sezzleData.publicKey }}"
                 data-sezzle-express-checkout="{{ (sezzleData.expressCheckout ?? false) ? '1' : '0' }}"
                 data-sezzle-amount="{{ sezzleData.amount ?? 0 }}"
                 data-sezzle-amount-in-cents="{{ sezzleData.amountInCents ?? 0 }}"
                 data-sezzle-currency="{{ sezzleData.currency ?? 'USD' }}"
                 data-sezzle-intent="{{ sezzleData.intent ?? 'AUTH' }}"
                 data-sezzle-reference-id="{{ sezzleData.referenceId ?? '' }}"
                 data-sezzle-description="{{ sezzleData.description ?? 'Order from Shopware' }}"
                 hidden
                 aria-hidden="true">
                <div id="sezzle-smart-button-container" hidden aria-hidden="true"></div>
                <div id="sezzle-window"></div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block component_payment_method_description %}
    {{ parent() }}

    {% if payment.id and payment.handlerIdentifier == 'Sezzle\\Gateways\\SezzlePaymentHandler' %}
        {% set sezzleData = page.extensions.sezzle ?? null %}

        {% if sezzleData and sezzleData.enablePromotionalWidget %}
            {% set installment = (sezzleData.amount / 4)|round(2) %}
            <p class="sezzle-shopify-buy-static-widget">
                Buy now, pay later in 4 payments of
                <strong>{{ sezzleData.currency }} {{ installment|number_format(2, '.', ',') }}</strong>
                with
                <img class="sezzle-logo"
                     src="https://media.sezzle.com/branding/2.0/Sezzle_Logo_FullColor.svg"
                     alt="Sezzle logo"
                     style="display:inline-block;height:18px;margin:0 0 -3px 0;">
                <a class="sezzle-info-link"
                   href="https://sezzle.com/how-it-works"
                   target="_blank"
                   rel="noopener noreferrer"
                   style="text-decoration:none;border:none;padding:0 5px;">&#9432;</a>
            </p>
        {% endif %}
    {% endif %}
{% endblock %}
