{% sw_extends '@Storefront/storefront/component/product/card/price-unit.html.twig' %}

{% block component_product_box_price %}
    {{ parent() }}

    {% set enablePriceBreakdownProduct = config('Sezzle.config.enablePriceBreakdownProduct')|default(false) %}

    {% if enablePriceBreakdownProduct %}

    <span class="sezzle-info-icon" style="
        display:inline-flex;
        align-items:center;
        justify-content:center;
        width:20px;
        height:20px;
        border-radius:50%;
        background:#8333d4;
        color:white;
        font-size:13px;
        font-weight:600;
        cursor:pointer;
        margin-left:6px;
    ">
        i
    </span>


    <section
            class="sezzle-checkout-modal-lightbox"
            role="dialog"
            aria-label="Sezzle Information"
            lang="en"
            style="display: none; max-height: 100%"
    >
        <style>
            @import url("https://fonts.cdnfonts.com/css/satoshi");
            @import url("https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@600&display=swap");

            .sezzle-modal-open {
                position: fixed;
                top: 0;
                bottom: 0;
                right: 0;
                left: 0;
            }

            .sezzle-checkout-modal-lightbox * {
                vertical-align: baseline;
                box-sizing: border-box;
                line-height: normal;
            }

            .sezzle-checkout-modal-lightbox {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 99999998;
                background-color: rgba(5, 31, 52, 0.57);
                width: 100vw;
                height: 100vh;
                overflow-y: auto;
                overflow-x: hidden;
                color: unset;
            }

            .sezzle-checkout-modal {
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                position: absolute;
                box-shadow: 0 10px 20px rgba(5, 31, 52, 0.19), 0 6px 6px rgba(5, 31, 52, 0.2);
                height: auto;
                max-height: 90%;
                width: 343px;
                color: #303030;
                font-family: Satoshi, "Open Sans", sans-serif;
                background-color: #fff;
                overflow: auto;
                padding: 20px 0;
                border-radius: 10px;
                box-sizing: border-box;
            }

            @media screen and (max-width: 374px) {
                .sezzle-checkout-modal {
                    transform: scale(0.9) translate(-55%, -55%);
                }
            }

            .sezzle-modal-header {
                position: relative;
                padding: 0 16px 10px;
            }

            .close-sezzle-modal {
                position: absolute;
                right: 16px;
                top: 0;
                width: 24px;
                height: 24px;
                opacity: 0.2;
                cursor: pointer;
                padding: 0;
                outline: 0;
                background: 0 0;
                border: none;
                box-shadow: none;
            }

            .close-sezzle-modal:hover {
                opacity: 1;
            }

            .close-sezzle-modal:focus {
                opacity: 0.5;
            }

            @media screen and (max-width: 600px) {
                .close-sezzle-modal {
                    opacity: 0.8;
                }

                .close-sezzle-modal:focus {
                    opacity: 1;
                }
            }

            .close-sezzle-modal::before {
                position: absolute;
                left: 10px;
                content: " ";
                top: 0;
                transform: rotate(45deg);
                background-color: #5e5e5e;
                width: 2px;
                height: 15px;
            }

            .close-sezzle-modal::after {
                position: absolute;
                left: 10px;
                content: " ";
                top: 0;
                transform: rotate(-45deg);
                background-color: #5e5e5e;
                width: 2px;
                height: 15px;
            }

            .sezzle-logo {
                display: block;
                height: 29.39px;
                width: 120px;
                margin: 10px auto 0;
                background-image: url(https://media.sezzle.com/branding/2.0/Sezzle_Logo_FullColor.svg);
                background-repeat: no-repeat;
                background-size: contain;
            }

            .sezzle-modal-content {
                height: auto;
                text-align: center;
                padding: 0 16px 16px;
            }

            .sezzle-header {
                display: block;
                text-align: center;
                font-style: normal;
                font-size: 19px;
                font-weight: 700;
                line-height: 26px;
                letter-spacing: 0.1px;
                font-family: Satoshi, "Open Sans", sans-serif;
                color: #303030;
                margin: 16px 0;
            }

            .sezzle-row {
                text-align: center;
                font-style: normal;
                font-size: 13px;
                font-weight: 400;
                line-height: 17px;
                color: #303030;
                letter-spacing: 0.4px;
                margin: 12px 0 24px;
                font-family: Satoshi, "Open Sans", sans-serif;
                display: grid;
                gap: 4px;
            }

            .sezzle-row span {
                display: block;
            }

            .sezzle-row span sup {
                font-size: 0.75em;
            }

            .sezzle-four-pay {
                display: flex;
                flex-direction: column;
                align-items: center;
                background: rgba(131, 51, 212, 0.05);
                border-radius: 16px;
                padding: 16px 8px;
                margin: 0 12px;
            }

            .sezzle-four-pay .sezzle-row {
                text-align: center;
                font-style: normal;
                font-size: 15px;
                font-weight: 500;
                line-height: 20px;
                font-family: Satoshi, "Open Sans", sans-serif;
                color: #303030;
                margin: 0 0 12px;
            }

            .sezzle-pie-area {
                display: flex;
                flex-direction: row;
                align-items: flex-start;
            }

            .due-today {
                display: flex;
                flex-direction: column;
                align-items: center;
                background: #fff;
                border-radius: 8px;
                margin: 0 4px;
                padding: 16px 0;
            }

            .future-payments {
                display: flex;
                flex-direction: row;
                align-items: center;
                background: #fff;
                border-radius: 8px;
                margin: 0 4px;
                padding: 0 4px;
            }

            .payment-item {
                padding: 16px 8px;
            }

            .breakdown-row {
                display: flex;
                flex-direction: column;
                align-items: center;
                margin: 0;
                padding: 8px 0 0;
            }

            .breakdown-row .percentage {
                text-align: center;
                font-style: normal;
                font-size: 13.4px;
                font-weight: 400;
                line-height: 18.76px;
                color: #8333d4;
                font-family: Satoshi, "Open Sans", sans-serif;
                align-items: center;
                letter-spacing: 0.13px;
            }

            .breakdown-row .due {
                text-align: center;
                font-style: normal;
                font-size: 10.72px;
                font-weight: 400;
                line-height: 15.18px;
                color: #5e5e5e;
                font-family: Satoshi, "Open Sans", sans-serif;
            }

            .sezzle-features {
                display: flex;
                flex-direction: column;
                align-items: center;
                margin: 16px;
            }

            .single-feature {
                text-align: center;
                font-style: normal;
                font-size: 13px;
                font-weight: 500;
                line-height: 17px;
                color: #303030;
                letter-spacing: 0.4px;
                margin: 8px auto;
                font-family: Satoshi, "Open Sans", sans-serif;
            }

            .terms-container {
                margin: 16px 12px 0;
            }

            .terms {
                text-align: center;
                font-style: normal;
                font-size: 11px;
                font-weight: 400;
                line-height: 12px;
                color: #5e5e5e;
                font-family: Satoshi, "Open Sans", sans-serif;
                margin: 4px 0;
            }

            .terms sup {
                font-size: 0.75em;
                padding-right: 2px;
            }

            .terms a {
                color: #8333d4;
                text-decoration: none;
            }

            .terms a:hover {
                color: #af0fda;
            }
        </style>

        <div
                id="sezzle-modal-container"
                role="dialog"
                aria-label="Sezzle Modal"
                aria-description="Learn more about Sezzle"
                class="sezzle-checkout-modal"
        >
            <div class="sezzle-modal-header">
                <button
                        role="button"
                        aria-label="Close Sezzle Modal"
                        class="close-sezzle-modal"
                ></button>
            </div>

            <div class="sezzle-logo" title="Sezzle"></div>

            <div id="sezzle-modal-core-content" class="sezzle-modal-content">
                <header class="sezzle-header">Buy Now. Pay Later.</header>

                <p class="sezzle-row">
                    <span>
                        Available for purchases of $35 to $2,500.<sup>1</sup>
                    </span>
                    <span>
                        Instant decision. No impact to your credit score.<sup>2</sup>
                    </span>
                </p>

                <div class="sezzle-four-pay">
                    <div class="sezzle-row">
                        <span>Split your purchase into 4 payments.</span>
                    </div>

                    <div class="sezzle-pie-area">
                        <div class="due-today">
                            <div class="payment-item">
                                <p class="breakdown-row">
                                    <span class="percentage">25%</span>
                                    <span class="due">Today</span>
                                </p>
                            </div>
                        </div>

                        <div class="future-payments">
                            <div class="payment-item">
                                <p class="breakdown-row">
                                    <span class="percentage">25%</span>
                                    <span class="due">Week 2</span>
                                </p>
                            </div>
                            <div class="payment-item">
                                <p class="breakdown-row">
                                    <span class="percentage">25%</span>
                                    <span class="due">Week 4</span>
                                </p>
                            </div>
                            <div class="payment-item">
                                <p class="breakdown-row">
                                    <span class="percentage">25%</span>
                                    <span class="due">Week 6</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sezzle-features">
                    <p class="single-feature">
                        1. Pay later by selecting Sezzle at checkout.
                    </p>
                    <p class="single-feature">
                        2. Complete your purchase with a 25% down payment.
                    </p>
                    <p class="single-feature">
                        3. Schedule the rest of your payments.
                    </p>
                </div>

                <div class="terms-container">
                    <p class="terms">
                        <span class="webbank-terms">
                            Pay in 4 and Pay in 2 loans are originated by WebBank except loans in IA, Puerto Rico and Canada.
                            For example, for a $300 Pay in 4 loan, you would make one $75 down payment today, then three $75
                            payments every two weeks for a 35.40% annual percentage rate (APR) and a total of payments of
                            $305.99 which includes a $5.99 Service Fee (finance charge) charged at loan origination. Service fees
                            vary and can range from $0 to $5.99 depending on the purchase price and Sezzle product. Actual fees are
                            reflected in checkout.
                        </span>
                        <br />
                        <a href="https://sezzle.com/how-it-works" target="_blank">
                            Learn more about Sezzle buy now, pay later here.
                        </a>
                    </p>

                    <p class="terms">
                        <sup>1</sup>Subject to approval.
                        <a href="https://www.sezzle.com/legal" target="_blank">
                            Click here for complete terms.
                        </a>
                        First payment date and amount may fluctuate based on eligibility and time of merchant order completion.
                    </p>

                    <p class="terms">
                        <sup>2</sup>Signing up for Sezzle will not impact your credit score. You may opt-in to our free credit
                        reporting program, Sezzle Up, to have your payments reported to credit bureaus.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <script type="text/javascript">
        (function () {
            function openSezzleModal(e) {
                if (e) {
                    e.preventDefault();
                }

                var target = document;
                var lightbox = target.querySelector('.sezzle-checkout-modal-lightbox');
                if (!lightbox) {
                    return;
                }

                lightbox.style.display = 'block';
                document.body.classList.add('sezzle-modal-open');
            }

            function closeSezzleModal(e) {
                if (e) {
                    e.preventDefault();
                }

                var target = document;
                var lightbox = target.querySelector('.sezzle-checkout-modal-lightbox');
                if (!lightbox) {
                    return;
                }

                lightbox.style.display = 'none';
                document.body.classList.remove('sezzle-modal-open');
            }

            function addInfoListener() {
                var target = document;
                var sezzleInfoIcons = target.getElementsByClassName('sezzle-info-icon');

                for (var i = 0; i < sezzleInfoIcons.length; i++) {
                    sezzleInfoIcons[i].addEventListener('click', openSezzleModal);
                }
            }

            function addModalListener() {
                var target = document;
                var sezzleModalClose = target.getElementsByClassName('close-sezzle-modal');

                for (var i = 0; i < sezzleModalClose.length; i++) {
                    sezzleModalClose[i].addEventListener('click', closeSezzleModal);
                }

                var overlay = target.querySelector('.sezzle-checkout-modal-lightbox');
                if (overlay) {
                    overlay.addEventListener('click', function (event) {
                        if (event.target === overlay) {
                            closeSezzleModal(event);
                        }
                    });
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                addInfoListener();
                addModalListener();
            });
        })();
    </script>

    <script src="https://widget.sezzle.com/v1/javascript/price-widget?d658037c-e9e9-4ec6-9ea3-a6af97763bd0="></script>
    <script type="text/javascript">
        document.sezzleConfig = {
            configGroups: [
                {
                    targetXPath: "#ProductPrice/.money"
                }
            ]
        };
    </script>
    {% endif %}
{% endblock %}