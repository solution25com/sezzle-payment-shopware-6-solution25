{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}

{% block page_checkout_confirm_form_submit %}
    {% set sezzleData = page.extensions.sezzle ?? null %}

    <div id="sezzle-plugin-wrapper"
         data-sezzle-plugin
         data-sezzle-merchant-id="{{ sezzleData.merchantId ?? '' }}"
         data-sezzle-mode="{{ sezzleData.mode ?? 'sandbox' }}"
         data-sezzle-popup-form-style="{{ sezzleData.popupFormStyle ?? 'popup' }}"
         data-sezzle-payment-flow="{{ sezzleData.flow ?? '' }}"
         data-sezzle-public-key="{{ sezzleData.publicKey ?? '' }}"
         data-sezzle-private-key="{{ sezzleData.privateKey ?? '' }}"
         data-sezzle-express-checkout="{{ sezzleData.expressCheckout ? '1' : '0' }}"
         data-sezzle-amount="{{ sezzleData.amount ?? 0 }}"
         data-sezzle-currency="{{ sezzleData.currency ?? 'USD' }}"
    ></div>

    {% if sezzleData and sezzleData.expressCheckout %}
        <div class="sezzle-express-checkout">
            <div id="sezzle-smart-button-container"
                 class="sezzle-smart-button-container"
                 templateText="Pay with %%logo%%"
                 borderType="semi-rounded"
                 customClass="action,primary,checkout">
            </div>
        </div>

        {{ parent() }}
    {% else %}
        {{ parent() }}
    {% endif %}

{% endblock %}

{% block page_checkout_confirm_payment_method %}
    {{ parent() }}

    {% set sezzleData = page.extensions.sezzle ?? null %}

    {% if sezzleData and sezzleData.enablePromotionalWidget %}
        <div
                class="sezzle-promotional-widget my-3"
                data-sezzle-promotional="checkout-promotional"
                data-sezzle-plugin
                data-sezzle-merchant-id="{{ sezzleData.merchantId }}"
                data-sezzle-mode="{{ sezzleData.mode }}"
        ></div>
    {% endif %}
{% endblock %}
