{% sw_extends '@Storefront/storefront/page/product-detail/index.html.twig' %}

{% block page_product_detail_content %}
    {{ parent() }}

    {% set sezzleData = page.extensions.sezzle ?? null %}
    
    {% if sezzleData and sezzleData.enablePriceBreakdown %}
        {% set productPrice = page.product.calculatedPrice.unitPrice ?? page.product.calculatedPrice.totalPrice ?? 0 %}
        
        {% if productPrice > 0 %}
            <div 
                class="sezzle-price-breakdown-product-detail my-3"
                data-sezzle-price-breakdown="product-detail-{{ page.product.id }}"
                data-sezzle-plugin
                data-sezzle-merchant-id="{{ sezzleData.merchantId }}"
                data-sezzle-mode="{{ sezzleData.mode }}"
                data-sezzle-amount="{{ productPrice }}"
                data-sezzle-currency="{{ sezzleData.currency }}"
            >
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

