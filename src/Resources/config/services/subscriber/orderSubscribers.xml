<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Sezzle\Subscriber\OrderPaidSubscriber">
            <argument type="service" id="Sezzle\Services\SezzleCustomerTokenizationService"/>
            <argument type="service" id="Sezzle\Services\SezzleClientService"/>
            <argument type="service" id="Sezzle\Services\OrderTransactionMapper\OrderTransactionMapper"/>
            <argument type="service" id="SezzlePayment.logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

    </services>
</container>

