<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Sezzle\Subscriber\CheckoutConfirmEventSubscriber">
            <argument type="service" id="Sezzle\Services\ConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Sezzle\Subscriber\ProductPageSubscriber">
            <argument type="service" id="Sezzle\Services\ConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Sezzle\Subscriber\CartPageSubscriber">
            <argument type="service" id="Sezzle\Services\ConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Sezzle\Subscriber\HomePageSubscriber">
            <argument type="service" id="Sezzle\Services\ConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
