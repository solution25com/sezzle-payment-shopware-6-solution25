<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Sezzle\Services\AdminOrderCreationService">
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\CachedSalesChannelContextFactory"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Order\OrderPersister"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="payment_method.repository"/>
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="Sezzle\Services\SezzleClientService"/>
            <argument type="service" id="Sezzle\Services\ConfigService"/>
            <argument type="service" id="Sezzle\Services\OrderTransactionMapper\OrderTransactionMapper"/>
        </service>

        <service id="Sezzle\Controller\Admin\SezzleOrderCreationController" public="true">
            <argument type="service" id="Sezzle\Services\AdminOrderCreationService"/>
            <argument type="service" id="Sezzle\Services\SezzleCustomerService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>

