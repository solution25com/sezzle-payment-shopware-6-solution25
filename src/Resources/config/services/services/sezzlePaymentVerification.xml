<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Sezzle\Services\SezzleWebhookSignatureVerifier"/>

        <service id="Sezzle\Services\SezzleOrderPaymentStatusResolver">
            <argument type="service" id="Sezzle\Services\SezzleClientService"/>
            <argument type="service" id="Sezzle\Services\ConfigService"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
        </service>
    </services>
</container>
