<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Sezzle\Services\SezzleCustomerTokenizationService">
            <argument type="service" id="sezzle_customer.repository"/>
            <argument type="service" id="Sezzle\Services\SezzleClientService"/>
        </service>

        <service id="Sezzle\Services\WebhookManagementService">
            <argument type="service" id="Sezzle\Services\SezzleClientService"/>
            <argument type="service" id="Sezzle\Services\ConfigService"/>
        </service>

        <service id="Sezzle\Services\ExpressCheckoutService">
            <argument type="service" id="Sezzle\Services\SezzleClientService"/>
            <argument type="service" id="Sezzle\Services\ConfigService"/>
            <argument type="service" id="shipping_method.repository"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\SalesChannel\ContextSwitchRoute"/>
        </service>
    </services>
</container>

