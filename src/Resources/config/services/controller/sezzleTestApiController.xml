<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Sezzle\Storefront\Controller\SezzleTestApiController" public="true">
            <argument type="service" id="Sezzle\Services\TestConnectionService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Sezzle\Storefront\Controller\WebhookController" public="true">
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Sezzle\Services\PaymentTransactionStateHandler\SezzleTransactionStateHandler"/>
            <argument type="service" id="Sezzle\Services\OrderTransactionMapper\OrderTransactionMapper"/>
            <argument type="service" id="Sezzle\Services\SezzleClientService"/>
            <argument type="service" id="SezzlePayment.logger"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Sezzle\Storefront\Controller\SezzleCancelController" public="true">
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Sezzle\Storefront\Controller\ExpressCheckoutController" public="true">
            <argument type="service" id="Sezzle\Services\ExpressCheckoutService"/>
            <argument type="service" id="Sezzle\Services\SezzleCustomerTokenizationService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>