<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Sezzle\Controller\Admin\SezzleWebhookController" public="true">
            <argument type="service" id="Sezzle\Services\WebhookManagementService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Sezzle\Controller\Admin\SezzleWebhookManagementController" public="true">
            <argument type="service" id="Sezzle\Services\WebhookManagementService"/>
            <argument type="service" id="Sezzle\Services\ConfigService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Sezzle\Controller\Admin\SezzleOrderController" public="true">
            <argument type="service" id="order.repository"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>

