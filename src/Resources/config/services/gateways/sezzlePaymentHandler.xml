<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Sezzle\Gateways\SezzlePaymentHandler">
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Sezzle\Services\SezzleClientService"/>
            <argument type="service" id="Sezzle\Services\OrderTransactionMapper\OrderTransactionMapper"/>
            <argument type="service" id="Sezzle\Services\ConfigService"/>
            <tag name="shopware.payment.method"/>
        </service>
    </services>
</container>