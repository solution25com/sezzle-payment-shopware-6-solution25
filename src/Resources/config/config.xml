<?xml version="1.0" encoding="UTF-8"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title lang="en-GB">Seezle Settings</title>
        <title lang="de-DE">Seezle Einstellungen</title>

        <input-field type="single-select">
            <name>mode</name>
            <label lang="en-GB">Mode</label>
            <label lang="de-DE">Modus</label>
            <options>
                <option>
                    <id>sandbox</id>
                    <name lang="en-GB">Sandbox</name>
                    <name lang="de-DE">Sandbox</name>
                </option>
                <option>
                    <id>live</id>
                    <name lang="en-GB">Live</name>
                    <name lang="de-DE">Live</name>
                </option>
            </options>
            <defaultValue>sandbox</defaultValue>
        </input-field>

        <input-field type="text">
            <name>apiKeySandbox</name>
            <label lang="en-GB">Api Key Sandbox</label>
            <label lang="de-DE">API-Schlüssel Sandbox</label>
        </input-field>

        <input-field type="text">
            <name>apiPasswordSandbox</name>
            <label lang="en-GB">Api Password Sandbox</label>
            <label lang="de-DE">API-Passwort Sandbox</label>
        </input-field>

        <input-field type="text">
            <name>apiKeyLive</name>
            <label lang="en-GB">Api Key Live</label>
            <label lang="de-DE">API-Schlüssel Live</label>
        </input-field>

        <input-field type="password">
            <name>apiPasswordLive</name>
            <label lang="en-GB">Api Password Live</label>
            <label lang="de-DE">API-Passwort Live</label>
        </input-field>

        <input-field type="text">
            <name>merchantId</name>
            <label lang="en-GB">Merchant ID</label>
            <label lang="de-DE">Händler-ID</label>
            <required>true</required>
        </input-field>

        <component name="Seezle-api-test">
            <name>SezzleApiTest</name>
        </component>
    </card>

    <card>
        <title lang="en-GB">Checkout Presentation</title>
        <title lang="de-DE">Checkout-Darstellung</title>

        <input-field type="single-select">
            <name>popupFormStyle</name>
            <label lang="en-GB">Popup Form Style</label>
            <label lang="de-DE">Popup-Formularstil</label>
            <options>
                <option><id>popup</id><name lang="en-GB">Popup</name><name lang="de-DE">Popup</name></option>
                <option><id>redirect</id><name lang="en-GB">Redirect</name><name lang="de-DE">Weiterleitung</name></option>
            </options>
            <defaultValue>redirect</defaultValue>
        </input-field>

    </card>

       <card>
           <title lang="en-GB">Authorization &amp; Logging</title>
           <title lang="de-DE">Autorisierung &amp; Logging</title>

         <input-field type="single-select">
            <name>authorizeAndCapture</name>
            <label lang="en-GB">Transaction type</label>
            <label lang="de-DE">Transaktionstyp</label>
            <options>
                <option><id>auth</id><name lang="en-GB">Authorize</name><name lang="de-DE">Autorisieren</name></option>
                <option><id>direct_capture</id><name lang="en-GB">Capture</name><name lang="de-DE">Abbuchen</name></option>
            </options>
            <defaultValue>auth</defaultValue>
        </input-field>


        <input-field type="bool">
            <name>expressCheckoutEnabled</name>
            <label lang="en-GB">Enable Express Checkout</label>
            <label lang="de-DE">Express Checkout aktivieren</label>
            <helpText lang="en-GB">Disabled by default. Enable only after express checkout has been approved for your store.</helpText>
            <helpText lang="de-DE">Standardmäßig deaktiviert. Nur aktivieren, nachdem Express Checkout für Ihren Shop freigegeben wurde.</helpText>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>enableTokenization</name>
            <label lang="en-GB">Enable customer tokenization</label>
            <label lang="de-DE">Kundentokenisierung aktivieren</label>
            <helpText lang="en-GB">Requires legal/compliance approval before enabling.</helpText>
            <defaultValue>false</defaultValue>
        </input-field>


        <input-field type="bool">
            <name>loggingEnabled</name>
            <label lang="en-GB">Enable Logging</label>
            <label lang="de-DE">Logging aktivieren</label>
            <defaultValue>true</defaultValue>
        </input-field>
    </card>

    <card>
        <title lang="en-GB">Widgets &amp; Banners</title>
        <title lang="de-DE">Widgets &amp; Banner</title>

        <input-field type="bool">
            <name>enablePriceBreakdownCart</name>
            <label lang="en-GB">Enable Price Breakdown on Cart Page</label>
            <label lang="de-DE">Preisaufschlüsselung auf Warenkorbseite aktivieren</label>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>enablePromotionalWidget</name>
            <label lang="en-GB">Enable Promotional Widget</label>
            <label lang="de-DE">Werbe-Widget aktivieren</label>
            <defaultValue>false</defaultValue>
        </input-field>
    </card>

    <card>
        <title lang="en-GB">Webhook Configuration</title>
        <title lang="de-DE">Webhook-Konfiguration</title>

        <component name="sezzle-webhook-test">
            <name>SezzleWebhookTest</name>
        </component>

        <input-field type="multi-select">
            <name>webhookEvents</name>
            <label lang="en-GB">Webhook Events</label>
            <label lang="de-DE">Webhook-Ereignisse</label>
            <placeholder lang="en-GB">Select events to receive</placeholder>
            <placeholder lang="de-DE">Ereignisse auswählen</placeholder>
            <helpText lang="en-GB">Select which events you want to receive from Sezzle</helpText>
            <helpText lang="de-DE">Wählen Sie aus, welche Ereignisse Sie von Sezzle erhalten möchten</helpText>
            <options>
                <option>
                    <id>order.authorized</id>
                    <name lang="en-GB">Order Authorized</name>
                    <name lang="de-DE">Bestellung autorisiert</name>
                </option>
                <option>
                    <id>order.captured</id>
                    <name lang="en-GB">Order Captured</name>
                    <name lang="de-DE">Bestellung erfasst</name>
                </option>
                <option>
                    <id>order.refunded</id>
                    <name lang="en-GB">Order Refunded</name>
                    <name lang="de-DE">Bestellung erstattet</name>
                </option>
                <option>
                    <id>order.released</id>
                    <name lang="en-GB">Order Released</name>
                    <name lang="de-DE">Bestellung freigegeben</name>
                </option>
                <option>
                    <id>order.cancelled</id>
                    <name lang="en-GB">Order Cancelled</name>
                    <name lang="de-DE">Bestellung storniert</name>
                </option>
                <option>
                    <id>customer.tokenized</id>
                    <name lang="en-GB">Customer Tokenized</name>
                    <name lang="de-DE">Kunde tokenisiert</name>
                </option>
            </options>
        </input-field>

        <input-field type="text">
            <name>webhookUuid</name>
            <label lang="en-GB">Webhook UUID (Auto-configured)</label>
            <label lang="de-DE">Webhook-UUID (Auto-konfiguriert)</label>
            <helpText lang="en-GB">This is automatically set when you register the webhook</helpText>
            <helpText lang="de-DE">Dies wird automatisch beim Registrieren des Webhooks gesetzt</helpText>
            <disabled>true</disabled>
        </input-field>
    </card>

</config>
